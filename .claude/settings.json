{
  "permissions": {
    "allow": [
      "Bash(pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(ruff check*)",
      "Bash(black --check*)",
      "Bash(pre-commit run*)",
      "Bash(aws s3 cp * --no-sign-request*)",
      "Bash(aws s3 sync * --no-sign-request*)",
      "Bash(aws s3 ls * --no-sign-request*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(find . *)",
      "Bash(ls *)",
      "Bash(mkdir -p *)",
      "Bash(chmod +x *)",
      "Bash(detect-secrets scan*)"
    ],
    "deny": [
      "Bash(aws configure*)",
      "Bash(git push --force*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.sh\""
          }
        ]
      }
    ]
  }
}